{
  "name": "kalamkala",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate:local": "pnpm --filter @kalamkala/web db:migrate:local",
    "new:template": "pnpm --filter @kalamkala/templates new:template",
    "sync:templates": "pnpm --filter @kalamkala/templates sync:templates"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
