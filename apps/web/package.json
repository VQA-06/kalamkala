    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
