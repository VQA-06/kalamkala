    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@kalamkala/adapters-cloudflare": "workspace:*",
    "@kalamkala/app-core": "workspace:*",
    "@kalamkala/contracts": "workspace:*",
    "@kalamkala/db-schema": "workspace:*",
    "@kalamkala/templates": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
